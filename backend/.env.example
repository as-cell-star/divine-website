# ================================================================
# Divine Birth Midwifery Centre — Backend Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ================================================================

# ── Server ────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ── CORS: your frontend domain (no trailing slash) ────────────
FRONTEND_URL=https://divine-birth.netlify.app

# ── Email (nodemailer) ────────────────────────────────────────
# Using Gmail: enable "App Passwords" in your Google account.
# For other providers see https://nodemailer.com/smtp/
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-clinic-email@gmail.com
SMTP_PASS=your-gmail-app-password

# Where notification emails go (clinic inbox)
NOTIFY_EMAIL=info@divinebirthmidwifery.org

# ── Africa's Talking SMS (free sandbox for testing) ──────────
# Sign up at https://africastalking.com — free sandbox available
AT_API_KEY=your-africastalking-api-key
AT_USERNAME=your-africastalking-username
# Clinic phone that receives SMS notifications
CLINIC_PHONE=+254794444141
